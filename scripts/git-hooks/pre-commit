#!/usr/bin/env bash
# Tracked in git (not .git/hooks, which isn't) — active once per clone via:
#   git config core.hooksPath scripts/git-hooks
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

staged_kt_files=$(git diff --cached --name-only --diff-filter=ACM -- '*.kt' '*.kts' || true)

if [ -z "$staged_kt_files" ]; then
    exit 0
fi

echo "Running spotlessCheck on staged Kotlin files..."
./gradlew spotlessCheck -q
